# このファイルを .env.local という名前でコピーして、実際の値を入れてください。
# .env.local はgitにコミットされません（.gitignoreで除外済み）。
#
# 値はSupabaseの管理画面 → 該当プロジェクト → Project Settings → API から取得できます。

# プロジェクトのURL（例: https://xxxxxxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key（ブラウザに公開されて問題ない鍵）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key（絶対に公開しない・ブラウザに送らない鍵）
# 管理画面(/admin)からステータスを更新するAPIなど、サーバー側だけで使う
SUPABASE_SERVICE_ROLE_KEY=
