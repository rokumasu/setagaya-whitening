# このファイルを .env.local という名前でコピーして、実際の値を入れてください。
# .env.local はgitにコミットされません（.gitignoreで除外済み）。
#
# 値はSupabaseの管理画面 → 該当プロジェクト → Project Settings → API から取得できます。

# プロジェクトのURL（例: https://xxxxxxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key（ブラウザに公開されて問題ない鍵）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key（絶対に公開しない・ブラウザに送らない鍵）
# 管理画面(/admin)からステータスを更新するAPIなど、サーバー側だけで使う
SUPABASE_SERVICE_ROLE_KEY=

# 管理画面(/admin)のログインパスワード。ご自身で決めた文字列を入れてください
# （このファイルには書かず、.env.local にのみ実際の値を設定してください）
ADMIN_PASSWORD=

# オンライン診療で使うZoomの固定ミーティングリンク（担当医の個人ミーティングルームなど）
# 患者側の画面にそのまま表示されるので、公開して問題ないURLのみ設定してください
NEXT_PUBLIC_ZOOM_LINK=

# Stripeの管理画面（https://dashboard.stripe.com/test/apikeys）から取得する
# シークレットキー（テストモードは sk_test_... で始まる）。絶対にブラウザに渡さない
STRIPE_SECRET_KEY=

# Stripeの「Webhooks」設定画面で、Webhookエンドポイントを作成すると発行される
# 署名シークレット（whsec_... で始まる）
STRIPE_WEBHOOK_SECRET=

# このサイトの公開URL（決済完了後の戻り先などに使用）
# 例: https://setagaya-whitening.vercel.app（ローカルでは未設定でOK）
NEXT_PUBLIC_SITE_URL=

# Resend（https://resend.com/api-keys）から取得するAPIキー
# 注文確認・発送連絡メールの自動送信に使用する
RESEND_API_KEY=
